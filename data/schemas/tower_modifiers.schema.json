{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Tower Modifiers Data Schema",
    "description": "Tower Modifiers Data",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "attributes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "attribute": {
                                    "type": "string",
                                    "enum": [
                                        "DAMAGE",
                                        "RANGE",
                                        "RATE_OF_FIRE",
                                        "BULLET_SPEED",
                                        "MULTISHOT",
                                        "CRIT_CHANCE_PERCENT"
                                    ]
                                },
                                "value_type": {
                                    "type": "string",
                                    "enum": [
                                        "FLAT",
                                        "MULTIPLIER"
                                    ]
                                },
                                "value": "number"
                            },
                            "required": [
                                "attribute",
                                "value_type",
                                "value"
                            ]
                        }
                    }
                }
            }
        },
        "required": [
            "name",
            "attributes"
        ],
        "additionalProperties": false
    },
    "required": [
        "data"
    ],
    "additionalProperties": false
}
