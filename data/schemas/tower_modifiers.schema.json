{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Tower Modifiers Data Schema",
    "description": "Tower Modifiers Data",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value_type": {
                        "type": "string",
                        "enum": [
                            "FLAT",
                            "MULTIPLIER"
                        ]
                    },
                    "damage": {
                        "type": "number",
                        "minimum": 0
                    },
                    "range": {
                        "type": "number",
                        "minimum": 0
                    },
                    "rate_of_fire": {
                        "type": "number",
                        "minimum": 0
                    },
                    "bullet_speed": {
                        "type": "number",
                        "minimum": 0
                    },
                    "multishot": {
                        "type": "number",
                        "minimum": 0
                    },
                    "crit_chance_percent": {
                        "type": "number",
                        "minimum": 0
                    }
                },
                "required": [
                    "name",
                    "value_type"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "data"
    ],
    "additionalProperties": false
}
